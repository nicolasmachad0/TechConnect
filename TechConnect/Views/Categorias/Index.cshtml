@model IEnumerable<TechConnect.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<!-- Container principal da página -->

<div class="container mt-4">

    <!-- Cabeçalho da página -->

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold text-primary">Categorias</h1>

            <p class="text-secondary">
                Gerencie as categorias dos eventos
            </p>
        </div>


        <!-- Botão de cadastro visível apenas para administradores -->

        <div>
            @if (User.Identity.Name == "admin@techconnect.com")
                {
                    <a asp-action="Create" class="btn btn-primary">
                        + Novo Evento
                    </a>
                }
        </div>

    </div>

     <!-- Campo de busca de categorias -->

    <div class="mb-4">

        <input type="text"
               id="buscarCategoria"
               class="form-control"
               placeholder="Buscar categoria..." />

    </div>

     <!-- Listagem de categorias -->

    <div class="row" id="listaCategorias">

        @foreach (var item in Model)
        {
            <!-- Card da categoria -->
            <div class="col-md-4 mb-4 card-categoria">

                <div class="card shadow border-0 h-100">

                    <div class="card-body text-center">

                        <!-- Ícone com inicial da categoria -->

                        <div class="mb-3">

                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                                 style="width: 80px; height: 80px; font-size: 30px;">

                                @item.Nome.Substring(0,1).ToUpper()

                            </div>

                        </div>

                        <!-- Nome da categoria -->

                        <h4 class="fw-bold">
                            @item.Nome
                        </h4>

                    </div>

                    <!-- Ações da categoria -->
                    <div class="card-footer bg-white border-0">

                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Detalhes
                            </a>

                            @if (User.Identity.Name == "admin@techconnect.com")
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        Excluir
                                    </a>
                                }

                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <!-- Mensagem exibida quando não houver resultados -->
    <div id="nenhumaCategoria"
     class="text-center mt-5"
     style="display: none;">

    <div class="alert alert-dark border border-secondary p-4">

        <h4 class="fw-bold mb-3">
            Ops... nenhuma categoria encontrada ou cadastrada!
        </h4>

        <p class="text-secondary mb-0">
            Tente pesquisar outro nome ou crie uma nova categoria.
        </p>

    </div>

</div>

</div>

<script>

     // Busca dinâmica das categorias

    const buscaCategoria = document.getElementById('buscarCategoria');

    buscaCategoria.addEventListener('keyup', function () {

        let filtro = buscaCategoria.value.toLowerCase();

        let cards = document.querySelectorAll('.card-categoria');

        let encontrou = false;

        cards.forEach(card => {

            let texto = card.innerText.toLowerCase();

            if (texto.includes(filtro)) {

                card.style.display = '';

                encontrou = true;

            }
            else {

                card.style.display = 'none';

            }

        });

        // Exibe mensagem quando nenhum resultado for encontrado

        const mensagem = document.getElementById('nenhumaCategoria');

        if (encontrou) {

            mensagem.style.display = 'none';

        }
        else {

            mensagem.style.display = 'block';

        }

    });

</script>