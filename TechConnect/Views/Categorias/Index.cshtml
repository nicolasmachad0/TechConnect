@model IEnumerable<TechConnect.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold text-primary">Categorias</h1>

            <p class="text-secondary">
                Gerencie as categorias dos eventos
            </p>
        </div>

        <div>
            @if (User.Identity.Name == "admin@techconnect.com")
                {
                    <a asp-action="Create" class="btn btn-primary">
                        + Novo Evento
                    </a>
                }
        </div>

    </div>

    <div class="mb-4">

        <input type="text"
               id="buscarCategoria"
               class="form-control"
               placeholder="Buscar categoria..." />

    </div>

    <div class="row" id="listaCategorias">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4 card-categoria">

                <div class="card shadow border-0 h-100">

                    <div class="card-body text-center">

                        <div class="mb-3">

                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                                 style="width: 80px; height: 80px; font-size: 30px;">

                                @item.Nome.Substring(0,1).ToUpper()

                            </div>

                        </div>

                        <h4 class="fw-bold">
                            @item.Nome
                        </h4>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Detalhes
                            </a>

                            @if (User.Identity.Name == "admin@techconnect.com")
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        Excluir
                                    </a>
                                }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<script>

    const buscaCategoria = document.getElementById('buscarCategoria');

    buscaCategoria.addEventListener('keyup', function () {

        let filtro = buscaCategoria.value.toLowerCase();

        let cards = document.querySelectorAll('.card-categoria');

        cards.forEach(card => {

            let texto = card.innerText.toLowerCase();

            if (texto.includes(filtro)) {
                card.style.display = '';
            }
            else {
                card.style.display = 'none';
            }

        });

    });

</script>