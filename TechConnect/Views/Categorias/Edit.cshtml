@model TechConnect.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="container py-5">

    <div class="card-dark-form mx-auto" style="max-width: 700px;">

        <div class="mb-4">
            <h1 class="titulo-form">Editar Categoria</h1>
            <p class="subtitulo-form">
                Atualize as informações da categoria.
            </p>
        </div>

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label asp-for="Nome" class="form-label-custom"> Nome da Categoria </label>             
                <input asp-for="Nome" class="form-control input-dark" placeholder="Digite o nome da categoria..." />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="d-flex gap-3 flex-wrap">
                <button type="submit" class="btn-tech"> Salvar Alterações </button>
                <a asp-action="Index" class="btn-cancelar"> Cancelar </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}