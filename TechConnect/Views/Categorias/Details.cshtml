@model TechConnect.Models.Categoria

@{
    ViewData["Title"] = "Details";
}

<!-- Título da página -->
<h1>Details</h1>

<div>
    <h4>Categoria</h4>
    <hr />

    <!-- Exibição dos dados da categoria -->
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
    </dl>
</div>

<div>
    <!-- Botão de edição visível apenas para o administrador -->
    @if (User.Identity.Name == "admin@techconnect.com")
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a>
    }
    |

    <!-- Botão para retornar à listagem -->
    <a asp-action="Index" class="btn-voltar"> Voltar </a>
    
</div>