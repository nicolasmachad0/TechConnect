@model IEnumerable<TechConnect.Models.Palestrante>

@{
    ViewData["Title"] = "Palestrantes";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold text-primary">Palestrantes</h1>
            <p class="text-secondary">
                Gerencie os palestrantes do evento de tecnologia
            </p>
        </div>

        <div>
             @if (User.Identity.Name == "admin@techconnect.com")
                {
                    <a asp-action="Create" class="btn btn-primary">
                        + Novo Evento
                    </a>
                }
        </div>

    </div>

    <div class="mb-4">
        <input type="text"
               id="buscarPalestrante"
               class="form-control"
               placeholder="Buscar palestrante por nome, empresa ou especialidade..." />
    </div>

    <div class="row" id="listaPalestrantes">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4 card-palestrante">

                <div class="card shadow border-0 h-100">

                    <div class="text-center p-3">

                        @if (!string.IsNullOrEmpty(item.Foto))
                        {
                            <img src="@item.Foto"
                                 class="rounded-circle shadow"
                                 style="width: 140px; height: 140px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/140"
                                 class="rounded-circle shadow" />
                        }

                    </div>

                    <div class="card-body">

                        <h4 class="fw-bold text-center">
                            @item.NomeCompleto
                        </h4>

                        <p class="text-center text-muted mb-1">
                            <strong>Empresa:</strong> @item.Empresa
                        </p>

                        <p class="text-center text-muted mb-2">
                            <strong>Especialidade:</strong> @item.Especialidade
                        </p>

                        <p class="text-secondary">
                            @item.Biografia
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Detalhes
                            </a>

                            @if (User.Identity.IsAuthenticated)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        Excluir
                                    </a>
                                }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<script>

    const busca = document.getElementById('buscarPalestrante');

    busca.addEventListener('keyup', function () {

        let filtro = busca.value.toLowerCase();

        let cards = document.querySelectorAll('.card-palestrante');

        cards.forEach(card => {

            let texto = card.innerText.toLowerCase();

            if (texto.includes(filtro)) {
                card.style.display = '';
            }
            else {
                card.style.display = 'none';
            }

        });

    });

</script>