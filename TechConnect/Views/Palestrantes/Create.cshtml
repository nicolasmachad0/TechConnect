@model TechConnect.Models.Palestrante

@{
ViewData["Title"] = "Novo Palestrante";
}

<div class="container py-4">


<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow border-0 rounded-4">

            <div class="card-header bg-dark text-white rounded-top-4 p-4">
                <h2 class="mb-1 fw-bold">Cadastrar Palestrante</h2>
                <p class="mb-0 text-light">
                    Adicione um novo palestrante ao TechConnect.
                </p>
            </div>

            <div class="card-body p-4">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label fw-semibold">Nome Completo</label>
                        <input asp-for="NomeCompleto" class="form-control form-control-lg" />
                        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="Empresa" class="form-label fw-semibold">Empresa </label>
                            <input asp-for="Empresa" class="form-control form-control-lg"/>
                            <span asp-validation-for="Empresa" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Cargo" class="form-label fw-semibold">Cargo</label>
                            <input asp-for="Cargo" class="form-control form-control-lg" />
                            <span asp-validation-for="Cargo" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="mb-3">
                        <label asp-for="Especialidade" class="form-label fw-semibold">Especialidade</label>
                        <input asp-for="Especialidade" class="form-control form-control-lg" />
                        <span asp-validation-for="Especialidade" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Biografia" class="form-label fw-semibold">Biografia</label>
                        <textarea asp-for="Biografia" class="form-control" rows="5"></textarea>     
                        <span asp-validation-for="Biografia" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Foto" class="form-label fw-semibold">URL da Foto</label>
                        <input asp-for="Foto" class="form-control form-control-lg" />
                        <span asp-validation-for="Foto" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark btn-lg px-4">Salvar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Voltar</a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

</div>

@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}
