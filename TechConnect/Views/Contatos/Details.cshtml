@model TechConnect.Models.Contato

@{
    ViewData["Title"] = "Detalhes do Contato";
}

<!-- Container principal da página -->
<div class="container mt-4">

    <!-- Card com as informações do contato -->
    <div class="card shadow-lg border-0">

        <div class="card-body p-4">

            <!-- Cabeçalho da página -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                <div>
                    <h1 class="fw-bold text-primary mb-1">
                        Detalhes do Contato
                    </h1>
                    <p class="text-secondary mb-0">
                        Visualize as informações enviadas pelo usuário
                    </p>
                </div>
            </div>

            <hr class="mb-4" />

            <!-- Exibição dos dados do contato -->
            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label text-secondary">Nome</label>
                    <div class="form-control bg-dark text-white border-secondary">@Model.Nome</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary">Email</label>
                    <div class="form-control bg-dark text-white border-secondary">@Model.Email</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary">Assunto </label>
                    <div class="form-control bg-dark text-white border-secondary">@Model.Assunto</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-secondary">Data de Envio</label>
                    <div class="form-control bg-dark text-white border-secondary">@Model.DataEnvio.ToString("dd/MM/yyyy") </div>
                </div>

                <div class="col-12">
                    <label class="form-label text-secondary">Mensagem </label>
                    <textarea class="form-control bg-dark text-white border-secondary" rows="6" readonly>@Model.Mensagem</textarea>
                </div>

            </div>

            <!-- Botões de ação -->
            <div class="mt-5 d-flex gap-3 flex-wrap">

                @if (User.Identity.Name == "admin@techconnect.com")
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
                }

                <a asp-action="Index" class="btn btn-outline-light">Voltar</a>

            </div>

        </div>

    </div>

</div>