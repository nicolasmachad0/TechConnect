@model TechConnect.Models.Contato

@{
    ViewData["Title"] = "Novo Contato";
}

<!-- Container principal da página -->
<div class="container mt-4">

    <!-- Card do formulário de contato -->
    <div class="card shadow border-0">

        <!-- Cabeçalho do formulário -->
        <div class="card-header bg-primary text-white">
            <h3>Novo Contato</h3>
        </div>

        <div class="card-body">

            <!-- Formulário de envio de contato -->
            <form asp-action="Create">

                <!-- Exibição de erros de validação -->
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Campo nome -->
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <!-- Campo e-mail -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>

                <!-- Campo assunto -->
                <div class="mb-3">
                    <label asp-for="Assunto" class="form-label"></label>
                    <input asp-for="Assunto" class="form-control" />
                </div>

                <!-- Campo mensagem -->
                <div class="mb-3">
                    <label asp-for="Mensagem" class="form-label"></label>
                    <textarea asp-for="Mensagem" class="form-control" rows="6"></textarea>
                </div>

                <!-- Campo data de envio -->
                <div class="mb-4">

                    <label asp-for="DataEnvio" class="form-label"></label>
                    <input asp-for="DataEnvio" type="date" class="form-control" />
                </div>

                <!-- Botões de ação -->
                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-success">Enviar Contato</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>

            </form>

        </div>

    </div>

</div>

<!-- Scripts de validação -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}