@model TechConnect.Models.Contato

@{
    ViewData["Title"] = "Editar Contato";
}

<!-- Container principal da página -->
<div class="container mt-4">

    <!-- Card do formulário de edição -->
    <div class="card shadow border-0">

        <!-- Cabeçalho da página -->
        <div class="card-header bg-warning text-dark">
            <h3>Editar Contato</h3>
        </div>

        <div class="card-body">

            <!-- Formulário de edição -->
            <form asp-action="Edit">

                <!-- Exibição de erros de validação -->
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <!-- Campo nome -->
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <!-- Campo e-mail -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Campo assunto -->
                <div class="mb-3">
                    <label asp-for="Assunto" class="form-label"></label>
                    <input asp-for="Assunto" class="form-control" />
                    <span asp-validation-for="Assunto" class="text-danger"></span>
                </div>

                <!-- Campo mensagem -->
                <div class="mb-3">
                    <label asp-for="Mensagem" class="form-label"></label>
                    <textarea asp-for="Mensagem" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Mensagem" class="text-danger"></span>
                </div>

                <!-- Campo data de envio -->
                <div class="mb-4">
                    <label asp-for="DataEnvio" class="form-label"></label>
                    <input asp-for="DataEnvio" type="date" class="form-control" />
                    <span asp-validation-for="DataEnvio" class="text-danger"></span>
                </div>

                <!-- Botões de ação -->
                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-warning">Salvar Alterações</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Scripts de validação -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}