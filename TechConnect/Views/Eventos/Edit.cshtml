@model TechConnect.Models.Evento

@{
    ViewData["Title"] = "Editar Evento";
}

<!-- Container principal da página -->
<div class="container mt-4">

    <!-- Card do formulário de edição -->
    <div class="card shadow border-0">

        <!-- Cabeçalho da página -->
        <div class="card-header bg-warning text-dark">
            <h3>Editar Evento</h3>
        </div>

        <div class="card-body">

            <!-- Formulário de edição do evento -->
            <form asp-action="Edit">

                <input type="hidden" asp-for="Id" />

                <!-- Exibição de erros de validação -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <!-- Informações principais do evento -->
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"> </label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <div class="mb-3">

                    <label asp-for="Descricao" class="form-label"> </label>
                    <textarea asp-for="Descricao" class="form-control" rows="5"> </textarea>

                </div>

                <!-- Data e horário do evento -->
                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Data" class="form-label"> </label>
                        <input asp-for="Data" type="date" class="form-control"/>

                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Horario" class="form-label"> </label>
                        <input asp-for="Horario" type="time" class="form-control"/>
                    </div>

                </div>

                <!-- Local do evento -->
                <div class="mb-3">

                    <label asp-for="Local" class="form-label"> </label>
                    <input asp-for="Local" class="form-control"/>

                </div>

                <hr class="my-4" />

                <!-- Seleção de categorias -->
                <h5 class="mb-3">
                    Categorias
                </h5>

                @foreach (var categoria in ViewBag.Categorias)
                {
                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               name="CategoriasSelecionadas"
                               value="@categoria.Id"

                               @(ViewBag.CategoriasSelecionadas.Contains(categoria.Id)
                                    ? "checked"
                                    : "") />

                        <label class="form-check-label">
                            @categoria.Nome
                        </label>

                    </div>
                }

                <hr class="my-4" />

                <!-- Seleção de palestrantes -->
                <h5 class="mb-3">
                    Palestrantes
                </h5>

                @foreach (var palestrante in ViewBag.Palestrantes)
                {
                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               name="PalestrantesSelecionados"
                               value="@palestrante.Id"

                               @(ViewBag.PalestrantesSelecionados.Contains(palestrante.Id)
                                    ? "checked"
                                    : "") />

                        <label class="form-check-label">
                            @palestrante.NomeCompleto
                        </label>

                    </div>
                }

                <!-- Campo para alterar a imagem do evento -->
                <div class="mb-4">

                    <label asp-for="Imagem"
                           class="form-label">
                    </label>

                    <input asp-for="Imagem"
                           class="form-control"
                           placeholder="Cole a URL do banner aqui"
                           id="inputImagem" />

                </div>

                <!-- Pré-visualização da imagem -->
                <div class="mb-4 text-center">

                    <img src="@Model.Imagem"
                         id="previewImagem"
                         class="img-fluid rounded shadow"
                         style="max-height: 350px;
                                width: 100%;
                                object-fit: cover;" />

                </div>

                <!-- Botões de ação -->
                <div class="d-flex gap-2 flex-wrap">

                    <button type="submit"
                            class="btn btn-warning">

                        Salvar Alterações

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Scripts de validação e atualização da prévia da imagem -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // Atualiza a pré-visualização da imagem em tempo real
        const inputImagem =
            document.getElementById("inputImagem");

        const previewImagem =
            document.getElementById("previewImagem");

        inputImagem.addEventListener("input", function () {

            previewImagem.src = inputImagem.value;

        });

    </script>
}