@model TechConnect.Models.Evento

@{
    ViewData["Title"] = "Detalhes do Evento";
}

<!-- Container principal da página -->
<div class="container mt-4">

    <!-- Card principal do evento -->
    <div class="card shadow border-0 overflow-hidden">

        <!-- Banner do evento -->
        <img src="@Model.Imagem" class="img-fluid" style="width:100%; max-height:450px; object-fit:cover;" />

        <div class="card-body p-4">

            <!-- Informações principais do evento -->
            <h1 class="fw-bold mb-3">
                @Model.Nome
            </h1>

            <p class="text-secondary fs-5">
                @Model.Descricao
            </p>

            <hr class="my-4" />

            <!-- Dados do evento -->
            <div class="row">

                <div class="col-md-4 mb-3">

                    <h5 class="text-primary fw-bold">
                        Data
                    </h5>

                    <p>
                        @Model.Data.ToShortDateString()
                    </p>

                </div>

                <div class="col-md-4 mb-3">

                    <h5 class="text-primary fw-bold">
                        Horário
                    </h5>

                    <p>
                        @Model.Horario
                    </p>

                </div>

                <div class="col-md-4 mb-3">

                    <h5 class="text-primary fw-bold">
                        Local
                    </h5>

                    <p>
                        @Model.Local
                    </p>

                </div>

            </div>

            <hr class="my-4" />

            <!-- Categorias vinculadas ao evento -->
            <h4 class="fw-bold mb-3">
                Categorias
            </h4>

            <div class="d-flex flex-wrap gap-2 mb-4">

                @foreach (var categoria in Model.EventoCategorias)
                {
                    <span class="badge bg-primary p-2 fs-6">
                        @categoria.Categoria.Nome
                    </span>
                }

            </div>

            <hr class="my-4" />

            <!-- Listagem de palestrantes -->
            <h3 class="fw-bold mb-4">
                Palestrantes
            </h3>

            <div class="row">

                @foreach (var item in Model.EventoPalestrantes)
                {
                    <!-- Card do palestrante -->
                    <div class="col-md-6 mb-4">

                        <div class="card h-100 shadow border-0">

                            <img src="@item.Palestrante.Foto" class="card-img-top" style="height:250px; object-fit:cover;" />

                            <div class="card-body">

                                <h4 class="fw-bold">
                                    @item.Palestrante.NomeCompleto
                                </h4>

                                <p class="text-primary fw-bold">
                                    @item.Palestrante.Empresa
                                </p>

                                <p>
                                    <strong>Cargo:</strong>
                                    @item.Palestrante.Cargo
                                </p>

                                <p>
                                    <strong>Especialidade:</strong>
                                    @item.Palestrante.Especialidade
                                </p>

                                <p>
                                    <strong>Tema da palestra:</strong>
                                    @item.Tema
                                </p>

                                <p class="text-secondary">
                                    @item.Palestrante.Biografia
                                </p>

                            </div>

                            <div class="card-footer bg-transparent border-0">

                                <a asp-controller="Palestrantes" asp-action="Details" asp-route-id="@item.Palestrante.Id" class="btn btn-primary w-100">
                                    Ver Perfil Completo
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

            <!-- Botões de ação -->
            <div class="d-flex gap-2 mt-4 flex-wrap">

                @if (User.Identity.Name == "admin@techconnect.com")
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">

                        Editar Evento

                    </a>
                }

                <a asp-action="Index" class="btn btn-secondary">
                    Voltar
                </a>

            </div>

        </div>

    </div>

</div>