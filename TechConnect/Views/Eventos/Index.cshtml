@model IEnumerable<TechConnect.Models.Evento>

@{
    ViewData["Title"] = "Eventos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold text-primary">Eventos</h1>
            <p class="text-secondary">
                Gerencie os eventos de tecnologia
            </p>
        </div>

        <div>
             @if (User.Identity.Name == "admin@techconnect.com")
                {
                    <a asp-action="Create" class="btn btn-primary">
                        + Novo Evento
                    </a>
                }
        </div>

    </div>

    <div class="mb-4">
        <input type="text"
               id="buscarEvento"
               class="form-control"
               placeholder="Buscar evento por nome, local ou descrição..." />
    </div>

    <div class="row" id="listaEventos">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4 card-evento">

                <div class="card shadow border-0 h-100">

                    @if (!string.IsNullOrEmpty(item.Imagem))
                    {
                        <img src="@item.Imagem"
                             class="card-img-top"
                             style="height: 220px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/500x250"
                             class="card-img-top" />
                    }

                    <div class="card-body">

                        <h4 class="fw-bold">
                            @item.Nome
                        </h4>

                        <p class="text-muted mb-2">
                            @item.Descricao
                        </p>

                        <p class="mb-1">
                            <strong>Data:</strong>
                            @item.Data.ToString("dd/MM/yyyy")
                        </p>

                        <p class="mb-1">
                            <strong>Horário:</strong>
                            @item.Horario
                        </p>

                        <p class="mb-1">
                            <strong>Local:</strong>
                            @item.Local
                        </p>

                        <p>
                            <strong>Categorias:</strong>

                            @foreach (var categoria in item.EventoCategorias)
                            {
                                <span class="badge bg-primary me-1">
                                    @categoria.Categoria?.Nome
                                </span>
                            }
                        </p>

                        <p>
                            <strong>Palestrantes:</strong>

                            @foreach (var palestrante in item.EventoPalestrantes)
                            {
                                <span class="badge bg-info text-dark me-1">
                                    @palestrante.Palestrante?.NomeCompleto
                                </span>
                            }
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Detalhes
                            </a>

                            @if (User.Identity.Name == "admin@techconnect.com")
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        Excluir
                                    </a>
                                }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<script>

    const busca = document.getElementById('buscarEvento');

    busca.addEventListener('keyup', function () {

        let filtro = busca.value.toLowerCase();

        let cards = document.querySelectorAll('.card-evento');

        cards.forEach(card => {

            let texto = card.innerText.toLowerCase();

            if (texto.includes(filtro)) {
                card.style.display = '';
            }
            else {
                card.style.display = 'none';
            }

        });

    });

</script>