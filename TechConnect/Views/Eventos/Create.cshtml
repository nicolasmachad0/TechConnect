@model TechConnect.Models.Evento

@{
    ViewData["Title"] = "Novo Evento";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h3>Novo Evento</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="5"></textarea>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Data" class="form-label"></label>

                        <input asp-for="Data"
                               type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Horario" class="form-label"></label>

                        <input asp-for="Horario"
                               type="time"
                               class="form-control" />
                    </div>

            

                </div>

                <div class="mb-3">
                    <label asp-for="Local" class="form-label"></label>
                    <input asp-for="Local" class="form-control" />
                </div>


                <hr class="my-4" />

                <h5 class="mb-3">Categorias</h5>

                @foreach (var categoria in ViewBag.Categorias)
                {
                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               name="CategoriasSelecionadas"
                               value="@categoria.Id" />

                        <label class="form-check-label">
                            @categoria.Nome
                        </label>

                    </div>
                }

                <hr class="my-4" />

                <h5 class="mb-3">Palestrantes</h5>

                @foreach (var palestrante in ViewBag.Palestrantes)
                {
                    <div class="form-check mb-2">

                        <input class="form-check-input"
                               type="checkbox"
                               name="PalestrantesSelecionados"
                               value="@palestrante.Id" />

                        <label class="form-check-label">
                            @palestrante.NomeCompleto
                        </label>

                    </div>
                }

                <div class="mb-4">
                    <label asp-for="Imagem" class="form-label"></label>
                    <input asp-for="Imagem"
                           class="form-control"
                           placeholder="Cole a URL do banner aqui" />
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-success">
                        Criar Evento
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>


            </form>

        </div>

    </div>


</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.palestrante-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const index = this.getAttribute('data-index');
                const temaInput = document.getElementById('tema' + index);
                temaInput.disabled = !this.checked;
                if (!this.checked) {
                    temaInput.value = '';
                }
            });
        });
    </script>
}

